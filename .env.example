# ============================================================
#  Ollama Gateway — plantilla de configuración
#  Copia este archivo como .env y ajusta los valores
# ============================================================

# --- App ---
APP_NAME=Ollama Gateway
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# --- Swagger (déjalos vacíos para ocultar la documentación en producción) ---
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# ============================================================
#  CONEXIÓN A SQL SERVER  <-- lo único que tienes que ajustar
# ============================================================
# OPCIÓN A (recomendada): los datos por separado.
# No hay que codificar nada: la contraseña puede llevar ] } @ / : # sin problema.
DB_HOST=localhost
DB_PORT=1433
DB_NAME=TU_BASE_DE_DATOS
DB_USER=sa
DB_PASSWORD=TU_PASSWORD
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=false

# OPCIÓN B: la cadena completa. Solo se usa si DB_HOST está vacío o comentado.
# OJO: aquí los símbolos de la contraseña SÍ van codificados en porcentaje:
#   ]  -> %5D      }  -> %7D      @  -> %40
#   /  -> %2F      :  -> %3A      #  -> %23      ?  -> %3F
# DATABASE_URL=mssql+aioodbc://sa:PASSWORD@localhost:1433/TU_BASE?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
#
# Autenticación de Windows (deja DB_HOST vacío y usa esta línea):
# DATABASE_URL=mssql+aioodbc://@localhost:1433/TU_BASE?driver=ODBC+Driver+18+for+SQL+Server&Trusted_Connection=yes&TrustServerCertificate=yes
#
# Azure SQL: pon DB_ENCRYPT=true

DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Rate limiting: "memory" (sin dependencias) o "redis" ---
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true
DEFAULT_REQUESTS_PER_MINUTE=60
DEFAULT_REQUESTS_PER_DAY=5000
DEFAULT_TOKENS_PER_DAY=1000000

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=300
DEFAULT_MODEL=qwen2.5:3b
ALLOWED_MODELS=["qwen2.5:3b"]

# --- Seguridad ---
API_KEY_PREFIX=sk_live_
# Genera uno real con:  python -c "import secrets;print(secrets.token_hex(32))"
ADMIN_TOKEN=cambia-este-token-antes-de-produccion
# --- CORS: orígenes del frontend autorizados ---
# Es una lista de ORÍGENES (esquema + host + puerto), sin rutas ni barra final.
# Cualquier origen que no esté aquí recibirá un error de CORS en el navegador.
CORS_ORIGINS=["https://idempotencia.andrescortes.dev","http://100.99.206.50:8081","http://localhost:3000","http://localhost:5173"]

# --- Logs ---
LOG_LEVEL=INFO
